# Optional CARTO Basemaps Key (MapLibre vector maps fall back to OpenFreeMap with zero keys)
# Obtain optional key: https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=

# Backend API Service URL (points to local or remote FastAPI backend)
VITE_API_URL=http://localhost:8000
