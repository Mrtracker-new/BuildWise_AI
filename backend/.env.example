# =============================================================================
# BuildWise AI — Backend Environment Configuration
# =============================================================================

# Server Network Interface and Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated origins allowed to make browser requests)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Explanation & Placement Provider
# Supported options: mock | groq | gemini | ollama
# System operates 100% deterministically with "mock" without any external API keys
DEFAULT_AI_PROVIDER=mock

# Optional API Keys (leave blank to run purely with zero-paid offline mock providers)
# Get Groq key: https://console.groq.com/
GROQ_API_KEY=
# Get Gemini key: https://aistudio.google.com/
GEMINI_API_KEY=

# Local Ollama Host URL (used when AI provider is set to "ollama")
OLLAMA_BASE_URL=http://localhost:11434
