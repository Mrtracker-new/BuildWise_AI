# BuildWise AI Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Explanation Provider
# Options: mock, groq, gemini, ollama
# System operates completely with "mock" without any external API keys
DEFAULT_AI_PROVIDER=mock

# Optional API Keys (Leave blank to use default mock provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
